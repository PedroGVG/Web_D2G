RewriteEngine On
RewriteBase /
Options -MultiViews

# Backups and authoring files must never be served by the production host.
RewriteRule ^(?:backups|scripts|tests|\.agent|\.git)(?:/|$) - [F,L]

AddType image/x-icon .ico
AddType application/manifest+json .webmanifest
AddType text/javascript .mjs
AddType font/ttf .ttf
AddType image/webp .webp

# Preserve old campaign and language URLs while consolidating indexing.
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$) [NC]
RewriteRule ^$ /en/ [R=301,L,NE,QSD]

RewriteCond %{QUERY_STRING} (^|&)lang=es(&|$) [NC]
RewriteRule ^$ /es/ [R=301,L,NE,QSD]

RewriteRule ^terminos/?$ /terminos-y-condiciones/ [R=301,L]
RewriteRule ^terminos-condiciones/?$ /terminos-y-condiciones/ [R=301,L]
RewriteRule ^terms/?$ /en/terms/ [R=301,L]
RewriteRule ^terms-and-conditions/?$ /en/terms/ [R=301,L]

RewriteRule ^v2/?$ /es/ [R=301,L]

# Remove index.html from the root and localized public URLs.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]

# Language negotiation for root URL:
# 1. Stored user preference via cookie
RewriteCond %{HTTP_COOKIE} \bd2g_lang=es\b [NC]
RewriteRule ^$ /es/ [R=302,L]

RewriteCond %{HTTP_COOKIE} \bd2g_lang=en\b [NC]
RewriteRule ^$ /en/ [R=302,L]

# 2. Browser Accept-Language detection
# Matches any Spanish language variety (es, es-ES, es-MX, es-AR, etc.)
RewriteCond %{HTTP:Accept-Language} ^es [NC]
RewriteRule ^$ /es/ [R=302,L]

# Regional preferences where Spanish is preferred over English
RewriteCond %{HTTP:Accept-Language} ^(?:ca|gl|eu)[^;]*,.*?\bes [NC]
RewriteRule ^$ /es/ [R=302,L]

# 3. Default: if not any kind of Spanish, redirect to English
RewriteRule ^$ /en/ [R=302,L]

# Inform caches and CDNs that root redirects vary based on Accept-Language and Cookie
<IfModule mod_headers.c>
  Header always merge Vary "Accept-Language, Cookie" "expr=%{REQUEST_URI} =~ m#^/$#"
</IfModule>
